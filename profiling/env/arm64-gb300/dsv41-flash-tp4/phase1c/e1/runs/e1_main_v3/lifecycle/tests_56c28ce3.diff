+def test_launcher_shutdown_while_importer_active_waits_then_leaves_importer(tmp_path, monkeypatch):
+    monkeypatch.setattr(procident, "is_descendant_of", lambda pid, root: True)
+    h = Harness(
+        tmp_path,
+        policy=_policy(soft_deadline_s=100, hard_deadline_s=200, session_close_timeout_s=30),
+        stop_return_at=None,
+    )
+    h.script_normal_stop(flush_s=30, import_s=10_000, with_report=False)
+    h.ctl.request_stop()
+
+    class Proc:
+        pid = NSYS_PID
+
+        def poll(self):
+            return None if h.procs.alive[NSYS_PID] else 0
+
+        def wait(self, timeout=None):
+            raise subprocess.TimeoutExpired("nsys", timeout)
+
+    killed = []
+    monkeypatch.setattr(os, "kill", lambda pid, sig: killed.append((pid, sig)))
+    monkeypatch.setattr(os, "killpg", lambda pgid, sig: killed.append(("pg", pgid, sig)))
+    h.ctl.shutdown(Proc())  # a launcher exception path reaches shutdown with the stop in flight
+    assert all(
+        pid != NSYS_PID for pid, *_ in killed if pid != "pg"
+    )  # nsys never interrupted while importing
+    assert not any(k[0] == "pg" for k in killed)  # no process-group SIGINT
+    status = h.ctl.status_dict()
+    assert any("left running" in w["message"] for w in status["warnings"])
+    assert (
+        API_PID,
+        signal.SIGTERM,
+    ) in h.procs.signals  # hard deadline released the GPUs on the way
