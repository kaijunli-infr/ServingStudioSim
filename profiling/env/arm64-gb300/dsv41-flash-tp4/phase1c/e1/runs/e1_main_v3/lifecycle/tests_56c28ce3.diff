+@pytest.mark.skipif(not sys.platform.startswith("linux"), reason="/proc based")
+def test_procident_refuses_own_ancestry_and_pid_reuse():
+    me = procident.identity(os.getpid())
+    assert me is not None and procident.is_alive(me)
+    log: list = []
+    assert procident.signal_verified(me, signal.SIGTERM, log) == "refused"
+    parent = procident.identity(os.getppid())
+    if parent is not None:
+        assert procident.signal_verified(parent, signal.SIGTERM, log) == "refused"
+    stale = procident.ProcessIdentity(
+        me.pid, me.starttime + 1, me.boot_id, me.uid, me.ppid, me.name, me.cmd
+    )
+    assert procident.signal_verified(stale, signal.SIGTERM, log) == "changed"
+    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(30)"])
+    try:
+        ident = procident.identity(child.pid)
+        assert ident is not None and procident.is_descendant_of(child.pid, os.getpid())
+        assert child.pid in procident.descendants(os.getpid())
+        assert procident.signal_verified(ident, signal.SIGTERM, log) == "signalled"
+        child.wait(timeout=10)
+        assert procident.signal_verified(ident, signal.SIGTERM, log) in ("gone", "changed")
+    finally:
+        if child.poll() is None:
+            child.kill()
+
