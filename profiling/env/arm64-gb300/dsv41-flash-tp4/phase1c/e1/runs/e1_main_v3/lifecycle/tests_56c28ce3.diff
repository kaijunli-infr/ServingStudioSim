+        "#!/bin/sh\nwhile [ $# -gt 0 ]; do case $1 in -i) IN=$2; shift;; -o) OUT=$2; shift;; esac; "
+        "shift; done\n"
+        'cat "$IN" > "$OUT"\n'
+    )
+    importer.chmod(0o755)
+    report = nsys_capture.import_stream(importer, preserved, h.stem)
