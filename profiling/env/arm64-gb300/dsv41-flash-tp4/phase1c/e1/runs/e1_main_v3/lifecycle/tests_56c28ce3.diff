diff --git a/tests/test_profiler_lifecycle.py b/tests/test_profiler_lifecycle.py
new file mode 100644
index 00000000..9c19bb39
--- /dev/null
+++ b/tests/test_profiler_lifecycle.py
@@ -0,0 +1,707 @@
+"""CPU tests for the profiler-stop lifecycle (alignment/profiler/lifecycle.py).
+
+Every scenario is driven by fakes: a simulated clock, a scripted server log that
+receives the lines Nsight and vLLM print, fake process identities, a recording
+signaller, a fake `/stop_profile` whose return is scheduled on the simulated
+clock, and injected disk-usage. No GPU, no nsys, no server.
+
+The scenarios are the ones the e1_main_v3 incident review asked for: an import
+longer than 20 minutes, repeated stop calls, a timeout during the import, a
+launcher shutdown while the importer is active, an import failure with a
+recoverable raw stream, GPU-release deadline expiry, disk-space exhaustion,
+partial export and restart/recovery, and that the launch recipe is unchanged.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import signal
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from alignment.profiler import lifecycle, nsys_capture, procident, vllm_server
+from alignment.profiler.config import NsysConfig
+from alignment.profiler.lifecycle import FinalizePolicy, Phase, ProfilerStopController
+
+REPO = Path(__file__).resolve().parents[1]
+FIXTURES = REPO / "tests" / "fixtures" / "e1_main_v3"
+
+NSYS_PID = 4000
+API_PID = 4100
+ENGINE_PID = 4200
+WORKER_PIDS = (4301, 4302, 4303, 4304)
+
+
+# ---- fakes
+class Clock:
+    def __init__(self):
+        self.t = 1000.0
+
+    def mono(self):
+        return self.t
+
+    def wall(self):
+        return 1_800_000_000.0 + self.t
+
+    def sleep(self, s):
+        self.t += s
+        for hook in list(self.hooks):
+            hook(self)
+
+    hooks: list = []
+
+
+class FakeProcs:
+    """Identity table: pid → (starttime, alive). Descendants: everything hangs off the nsys pid."""
+
+    def __init__(self):
+        self.alive = {
+            NSYS_PID: True,
+            API_PID: True,
+            ENGINE_PID: True,
+            **{p: True for p in WORKER_PIDS},
+        }
+        self.start = {p: 100 + i for i, p in enumerate(self.alive)}
+        self.signals: list[tuple[int, int]] = []
+        self.kill_ends_server = True
+
+    def identity(self, pid):
+        if not self.alive.get(pid):
+            return None
+        return procident.ProcessIdentity(
+            pid,
+            self.start[pid],
+            "boot",
+            1000,
+            NSYS_PID if pid != NSYS_PID else 1,
+            "p",
+            f"cmd {pid}",
+        )
+
+    def signaller(self, recorded, sig, log):
+        live = self.identity(recorded.pid)
+        if live is None:
+            log.append({"pid": recorded.pid, "action": "skip", "reason": "gone"})
+            return "gone"
+        if live.starttime != recorded.starttime:
+            log.append({"pid": recorded.pid, "action": "skip", "reason": "identity changed"})
+            return "changed"
+        self.signals.append((recorded.pid, sig))
+        log.append({"pid": recorded.pid, "action": signal.Signals(sig).name})
+        if self.kill_ends_server and recorded.pid == API_PID:
+            for p in (API_PID, ENGINE_PID, *WORKER_PIDS):
+                self.alive[p] = False
+        return "signalled"
+
+    def compute_pids(self):
+        return [p for p in WORKER_PIDS if self.alive[p]]
+
+
+class StopRequest:
+    """`/stop_profile` that returns (or fails) once the simulated clock passes `return_at`."""
+
+    def __init__(self, clock: Clock, return_at: float | None, error: str | None = None):
+        self.clock, self.return_at, self.error = clock, return_at, error
+        self.calls = 0
+
+    def __call__(self):
+        self.calls += 1
+        import time
+
+        while self.return_at is None or self.clock.t < self.return_at:
+            time.sleep(0.001)  # real thread: wait for the simulated clock
+        if self.error:
+            raise RuntimeError(self.error)
+
+
+class Harness:
+    def __init__(
+        self,
+        tmp_path: Path,
+        *,
+        policy: FinalizePolicy,
+        stop_return_at: float | None,
+        stop_error=None,
+        free_bytes=10**13,
+        is_descendant=True,
+    ):
+        self.clock = Clock()
+        Clock.hooks = []
+        self.procs = FakeProcs()
+        self.log = tmp_path / "server.log"
+        self.log.write_text(
+            f"(APIServer pid={API_PID}) INFO ready\n(EngineCore pid={ENGINE_PID}) INFO ready\n"
+            + "".join(f"(Worker_TP{i} pid={p}) INFO ready\n" for i, p in enumerate(WORKER_PIDS))
+        )
+        self.nsys_dir = tmp_path / "nsys"
+        self.nsys_dir.mkdir()
+        self.stem = self.nsys_dir / "run"
+        self.tmp = tmp_path / "tmp"
+        self.tmp.mkdir()
+        self.stream = self.tmp / "nsys-report-abcd.qdstrm"
+        self.stop = StopRequest(self.clock, stop_return_at, stop_error)
+        self.scheduled: list[tuple[float, callable]] = []
+
+        class DU:
+            def __init__(self, free):
+                self.free = free
+
+        self.free_bytes = free_bytes
+        self.monkey_is_desc = is_descendant
+        self.ctl = ProfilerStopController(
+            name="run",
+            server_log=self.log,
+            report_stem=self.stem,
+            status_path=self.nsys_dir / "lifecycle.json",
+            policy=policy,
+            stop_request=self.stop,
+            nsys_pid=NSYS_PID,
+            clock=self.clock.mono,
+            wallclock=self.clock.wall,
+            sleep=self.clock.sleep,
+            disk_usage=lambda p: DU(self.free_bytes),
+            gpu_compute_pids=self.procs.compute_pids,
+            signaller=self.procs.signaller,
+            identity=self.procs.identity,
+            emit=lambda s: None,
+        )
+        Clock.hooks.append(self._fire)
+
+    def at(self, t_rel: float, fn):
+        self.scheduled.append((1000.0 + t_rel, fn))
+
+    def _fire(self, clock):
+        due = [x for x in self.scheduled if x[0] <= clock.t]
+        self.scheduled = [x for x in self.scheduled if x[0] > clock.t]
+        for _, fn in sorted(due, key=lambda x: x[0]):
+            fn()
+
+    def append(self, text: str):
+        with self.log.open("a") as fh:
+            fh.write(text)
+
+    # the lines vLLM / nsys print, in the observed order
+    def script_normal_stop(self, *, flush_s, import_s, with_report=True):
+        self.at(
+            1,
+            lambda: self.append(
+                f"(APIServer pid={API_PID}) INFO [api_router.py:31] Stopping profiler...\n"
+            ),
+        )
+        self.at(
+            flush_s - 2,
+            lambda: self.append(
+                "Capture range started in the application.\n"
+                "Capture range ended in the application.\n"
+            ),
+        )
+
+        def gen():
+            self.stream.write_bytes(b"x" * 4096)
+            self.append(f"Generating '{self.stream}'\n")
+
+        self.at(flush_s, gen)
+        self.at(
+            flush_s + 1,
+            lambda: self.append(
+                "[1/1] [0%                          ] run.nsys-repProcessing events...\n"
+            ),
+        )
+        for k in range(1, 10):
+            pct = k * 10
+            self.at(
+                flush_s + 1 + import_s * k / 10,
+                lambda pct=pct: self.append(
+                    f"[1/1] [====={pct}%                    ] run.nsys-rep"
+                ),
+            )
+
+        def done():
+            if with_report:
+                self.stem.with_suffix(".nsys-rep").write_bytes(b"r" * 1024)
+                self.append("[1/1] [========================100%] run.nsys-rep\n")
+                self.stream.unlink(missing_ok=True)
+                self.append(
+                    f"(APIServer pid={API_PID}) INFO [api_router.py:33] Profiler stopped.\n"
+                )
+
+        self.at(flush_s + 1 + import_s, done)
+
+
+def _policy(**kw) -> FinalizePolicy:
+    base = dict(
+        soft_deadline_s=600.0,
+        hard_deadline_s=1200.0,
+        stall_timeout_s=300.0,
+        poll_interval_s=5.0,
+        session_close_timeout_s=60.0,
+        server_term_grace_s=10.0,
+    )
+    base.update(kw)
+    return FinalizePolicy(**base)
+
