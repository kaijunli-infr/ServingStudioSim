+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    r = sub.add_parser("record")
+    r.add_argument("--pod", required=True)
+    r.add_argument("--namespace", required=True)
+    r.add_argument("--node", required=True)
+    r.add_argument("--gpus", type=int, default=4)
+    r.add_argument("--out", required=True, type=Path)
+    v = sub.add_parser("verify")
+    v.add_argument("--reservation", required=True, type=Path)
+    v.add_argument("--host", default=socket.gethostname())
+    w = sub.add_parser("watch")
+    w.add_argument("--run", required=True, type=Path)
+    w.add_argument("--registry", required=True, type=Path)
+    w.add_argument("--attribute-registry", action="append", default=[], type=Path)
+    w.add_argument("--out", required=True, type=Path)
+    w.add_argument("--launch-latest-age-s", required=True, type=float)
+    w.add_argument("--never-launched-margin-s", type=float, default=60.0)
+    w.add_argument("--deleter-heartbeat", type=Path)
+    a = sub.add_parser("armed")
+    a.add_argument("--record", required=True, type=Path)
+    a.add_argument("--registry", type=Path)
+    a.add_argument("--max-age-s", type=float, default=30.0)
+    a.add_argument("--deleter-max-age-s", type=float, default=60.0)
+    d = sub.add_parser("delete")
+    d.add_argument("--reservation", required=True, type=Path)
+    d.add_argument("--permit-cmd", required=True, help="command that prints the watcher's record (run without a shell)")
+    d.add_argument("--publish-cmd", help="command that receives this process's record on stdin (run without a shell)")
+    d.add_argument("--out", required=True, type=Path)
+    d.add_argument("--fetch-timeout", type=float, default=20.0)
+    for p in (w, d):
+        p.add_argument("--ceiling-s", required=True, type=float)
+        p.add_argument("--tail-s", type=float, default=600.0)
+        p.add_argument("--interval", type=float, default=5.0)
+    for p in (r, v, w, d):
+        p.add_argument("--kubectl", default="kubectl --request-timeout=15s", help="kubectl command prefix (run without a shell)")
+    args = ap.parse_args(argv)
+    if args.cmd == "armed":
+        rc, text = armed(args.record, args.registry, max_age_s=args.max_age_s, deleter_max_age_s=args.deleter_max_age_s)
+        print(text)
+        return rc
+    prefix = shlex.split(args.kubectl)
+    if args.cmd == "record":
+        rc, lines = record(prefix, args.namespace, args.pod, args.node, args.out, gpus=args.gpus)
+        print("\n".join(lines))
+        return rc
+    if args.cmd == "verify":
+        rc, text = verify(prefix, args.reservation, args.host)
+        print(text)
+        return rc
+    if args.ceiling_s <= 0 or args.interval <= 0:
+        ap.error("--ceiling-s and --interval must be positive")
+    if args.cmd == "watch":
+        return watch(args.run, args.registry, args.out, prefix, ceiling_s=args.ceiling_s, launch_latest_age_s=args.launch_latest_age_s, never_launched_margin_s=args.never_launched_margin_s, tail_s=args.tail_s, interval=args.interval,
+                     attribute=args.attribute_registry, deleter_heartbeat=args.deleter_heartbeat)
+    return delete(args.reservation, shlex.split(args.permit_cmd), args.out, prefix, ceiling_s=args.ceiling_s, tail_s=args.tail_s, interval=args.interval, fetch_timeout=args.fetch_timeout, publish_cmd=shlex.split(args.publish_cmd) if args.publish_cmd else None)
+
