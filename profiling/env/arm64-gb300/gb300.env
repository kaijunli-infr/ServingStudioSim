# Source from the ServingStudio Sim repository root on a GB300 tray.
# Everything this environment writes lives under GB300_ROOT, on the shared
# CephFS home, never under /tmp or a tray's root disk; nothing is shared with
# other projects' caches or with the repository's own venv.
export GB300_ROOT="${GB300_ROOT:-/mnt/shared/home/kevin/workspace/serving-studio/gb300}"
mkdir -p "$GB300_ROOT"/{venv,cache/{uv,triton,flashinfer,torch-extensions,deepgemm,nv-compute,huggingface,vibesim-profiler,cupti-ext},db,artifacts,logs}

# The venv uv creates for profiling/env/arm64-gb300 and runs the Sim on.
export UV_PROJECT_ENVIRONMENT="$GB300_ROOT/venv"
export UV_CACHE_DIR="$GB300_ROOT/cache/uv"

# CUDA toolkit for JIT builds: 13.1, which the trays' 610.57 driver (CUDA 13.3
# user-mode) supports without minor-version compatibility shims; 13.4 is also
# installed but newer than the driver. Torch itself is the cu130 build.
export CUDA_HOME=/usr/local/cuda-13.1
export PATH="$CUDA_HOME/bin:$PATH"
# Only the GPU of the GB300 trays; keeps JIT builds from compiling other arches.
export TORCH_CUDA_ARCH_LIST="10.3"

# JIT and download caches, one per compiler, isolated from ~/.cache.
export TRITON_CACHE_DIR="$GB300_ROOT/cache/triton"
export FLASHINFER_WORKSPACE_BASE="$GB300_ROOT/cache/flashinfer"
export TORCH_EXTENSIONS_DIR="$GB300_ROOT/cache/torch-extensions"
export DG_JIT_CACHE_DIR="$GB300_ROOT/cache/deepgemm"
export CUDA_CACHE_PATH="$GB300_ROOT/cache/nv-compute"
export HF_HOME="$GB300_ROOT/cache/huggingface"
export VIBESIM_PROFILE_CACHE_DIR="$GB300_ROOT/cache/vibesim-profiler"
# The CUPTI timer's JIT-built extension; its default is $TMPDIR or /tmp on the
# tray's root disk (the containers set the same variable to /cache/cupti-ext).
export MOESIM_CUPTI_BUILD_DIR="$GB300_ROOT/cache/cupti-ext"
# Host runtime: workers run in this venv, not in the x86 profiler images.
export VIBESIM_PROFILE_RUNTIME=host

# Profile rows go to a private copy of the database, never to the tracked
# profiling/profile.db; merging into it is a separate, reviewed step.
export VIBESIM_PROFILE_DB="$GB300_ROOT/db/profile-gb300.db"
